<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_image_form_alt_text" model="ir.ui.view">
        <field name="name">product.image.view.form.alt.text</field>
        <field name="model">product.image</field>
        <field name="inherit_id" ref="website_sale.view_product_image_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']/.." position="after">
                <div class="mb-3" invisible="not id or video_url">
                    <button name="action_generate_alt_text" type="object" class="btn btn-secondary"
                            string="Generate Alt Text"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="action_product_image_generate_alt_text" model="ir.actions.server">
        <field name="name">Generate Alt Text</field>
        <field name="model_id" ref="website_sale.model_product_image"/>
        <field name="binding_model_id" ref="website_sale.model_product_image"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_generate_alt_text()</field>
    </record>

</odoo>
